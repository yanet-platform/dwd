[Unit]
Description=dwd-backend server (HTTP/HTTPS/HTTP3)
Documentation=file:/usr/share/doc/dwd-backend/README
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/dwd-backend --config /etc/dwd-backend/config.toml
Restart=on-failure
RestartSec=2

# Run as a dedicated unprivileged user, but allow binding to ports < 1024.
User=dwd-backend
Group=dwd-backend
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
LimitNOFILE=65535

# Strict protection
NoNewPrivileges=true
ProtectSystem=strict

ProtectHome=true
PrivateTmp=true

ReadOnlyPaths=/etc/dwd-backend

[Install]
WantedBy=multi-user.target
